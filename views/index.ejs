<div class="container my-5"> <!-- From the container page-->
    <div class="row align-items-center"> <!-- Puts the text and the photo side by side -->

      <div class="col-md-7">
        <h1 class="display-5 f-bold">Hi, I'm Chef Audrey</h1> <!--fw-bold is the font followed by bolding -->
