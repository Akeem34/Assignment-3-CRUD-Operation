<%- include ../partials/header.ejs %>
<%- include ../partials/main_nav.ejs %>
<!--Main content-->
<main class="container my-5">
    <div class="row">
        <div class="offset-md-1 col-md-10">

            <!-- Title on the left, Add button on the right -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="mb-0"><i class="fa-solid fa-book-open"></i> <%= title %></h1>
                <a class="btn btn-success" href="/recipes/add"><i class="fas fa-plus-circle"></i> Add Recipe</a>
            </div>

            <!-- table-responsive lets the table scroll sideways on small screens instead of breaking the page -->
            <div class="table-responsive shadow-sm rounded">
                <table class="table -middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center">Name</th>
                            <th class="text-center">Type</th>
                            <th class="text-center">Servings</th>
                            <th class="text-center">Prep Time</th>
                            <th class="text-center">Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <% for(let count=0; count<Recipelist.length; count++) { %>
                    <tr>
                        <td class="text-center col-2"><%= Recipelist[count].name %></td>
                        <td class="text-center col-1"><%= Recipelist[count].type %></td>
                        <td class="text-center col-1"><%= Recipelist[count].servings %></td>
                        <td class="text-center col-1"><%= Recipelist[count].prepTime %></td>
                        <td class="text-center col-4"><%= Recipelist[count].description %></td>
                        <td class="text-center col-3">
                            <a class="btn btn-primary btn-sm" href="/Recipes/edit/<%= Recipelist[count]._id %>">Edit</a>

                        <form class="d-inline" method="POST" action="/recipes/delete/<%= Recipelist[count]._id %>"
                                onsubmit="return confirm('Delete this recipe?');">
                            <button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i> Delete</button>
                        </form>
                        </td>
                    </tr>
                    <% } %>
                </table>
            </div>

        </div>
    </div>
</main>
<%- include ../partials/footer.ejs %>